@Bakery.Api_HostAddress = http://localhost:5000
@productId = replace-with-product-guid

GET {{Bakery.Api_HostAddress}}/health
Accept: application/json

###

GET {{Bakery.Api_HostAddress}}/api/products
Accept: application/json

###

POST {{Bakery.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "categoryId": "11111111-1111-1111-1111-111111111111",
  "name": "Sourdough loaf",
  "description": "Slow-fermented country sourdough",
  "price": 8.50,
  "imageUrl": "https://example.com/sourdough.jpg",
  "isAvailable": true
}

###

GET {{Bakery.Api_HostAddress}}/api/products/{{productId}}
Accept: application/json

###

POST {{Bakery.Api_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerId": "22222222-2222-2222-2222-222222222222",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2
    }
  ]
}

###

GET {{Bakery.Api_HostAddress}}/api/orders
Accept: application/json

###
