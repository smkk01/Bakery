{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Data": {
    "DirectoryPath": "data"
  },
  "Swagger": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "Bakery.Api",
    "Audience": "Bakery.Client",
    "AccessTokenMinutes": 60
  },
  "AllowedHosts": "*"
}
